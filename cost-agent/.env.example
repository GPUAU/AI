# 값은 Git에 올리지 않는다. 배포 환경에서는 Kubernetes Secret으로 주입한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# auto: 키가 있으면 openai, 없으면 rules / openai / rules
MAPPER=auto
SPRING_URL=http://backend
TEMPLATE_DIR=./data/templates
MAX_UPLOAD_MB=5

# LangSmith 추적 (선택). 켜도 금액·회사명·견적번호·사업장은 가린 채로만 나간다 (app/tracing.py)
