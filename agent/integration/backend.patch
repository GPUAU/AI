+package com.gpumarket.domain.market.service;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.sql.Timestamp;
+import java.time.Instant;
+import java.time.OffsetDateTime;
+import java.time.YearMonth;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+import java.util.TreeMap;
+import org.springframework.stereotype.Service;
+
+@Service
+public class MarketForecastService {
+  private static final int MIN_MONTHS = 24;
+  private static final int PATHS = 4000;
+  private static final int HORIZON = 12;
+  private static final long SEED = 20261123L;
+  private static final ZoneId KST = ZoneId.of("Asia/Seoul");
+  private final MarketHistoryService history;
+
+  public MarketForecastService(MarketHistoryService history) {
+    this.history = history;
+  }
+
+  public Map<String, Object> forecast(Map<String, String> filters, Instant asOf) {
+    var query = new LinkedHashMap<>(filters);
+    query.put("from", asOf.minus(1095, ChronoUnit.DAYS).atOffset(ZoneOffset.UTC).toString());
+    query.put("to", asOf.atOffset(ZoneOffset.UTC).toString());
+    query.put("limit", "3");
+    var data = history.publicHistory(query);
+    var series = records(data.get("series"));
+    var response = new LinkedHashMap<String, Object>();
+    response.put("asOf", asOf);
+    response.put("requiredMonths", MIN_MONTHS);
+    if (series.size() > 1 || data.get("nextCursor") != null) {
+      response.put("status", "NEEDS_CLARIFICATION");
+      response.put("reason", "예측할 오퍼 한 가지를 선택해 주세요. 오퍼 ID로 지정할 수 있습니다.");
+      response.put(
+          "offers",
+          series.stream()
+              .map(
+                  row ->
+                      Map.of(
+                          "offerId",
+                          row.get("offerId"),
+                          "providerName",
+                          row.get("providerName"),
+                          "regionCode",
+                          String.valueOf(row.get("regionCode"))))
+              .toList());
+      return response;
+    }
+    var monthly = new TreeMap<YearMonth, Map<String, Object>>();
+    if (!series.isEmpty()) {
+      for (var point : records(series.get(0).get("points"))) {
+        Object amount = point.get("effectiveUsdGpuHour");
+        if (amount == null || new BigDecimal(amount.toString()).signum() <= 0) continue;
+        monthly.put(YearMonth.from(instant(point.get("collectedAt")).atZone(KST)), point);
+      }
+      response.put("offerId", series.get(0).get("offerId"));
+    }
+    response.put("availableMonths", monthly.size());
+    if (monthly.isEmpty()) {
+      response.put("status", "INSUFFICIENT_HISTORY");
+      response.put("reason", "확인된 양수 공개가격 이력이 없습니다. 현재 공개가격 또는 과거 날짜를 조회해 주세요.");
+      return response;
+    }
+    response.put("historyFrom", monthly.firstKey().toString());
+    response.put("historyTo", monthly.lastKey().toString());
+    var trailing = new ArrayList<Map<String, Object>>();
+    for (YearMonth month = monthly.lastKey();
+        monthly.containsKey(month);
+        month = month.minusMonths(1)) {
+      trailing.add(0, monthly.get(month));
+    }
+    response.put("consecutiveMonths", trailing.size());
+    response.put(
+        "history",
+        monthly.entrySet().stream()
+            .map(
+                entry ->
+                    Map.of(
+                        "month", entry.getKey().toString(),
+                        "price", entry.getValue().get("effectiveUsdGpuHour"),
+                        "observationId", entry.getValue().get("observationId"),
+                        "collectedAt", entry.getValue().get("collectedAt"),
+                        "evidenceIds", entry.getValue().get("evidenceIds")))
+            .toList());
+    response.put("sources", data.getOrDefault("sources", List.of()));
+    if (trailing.size() < MIN_MONTHS
+        || monthly.lastKey().isBefore(YearMonth.from(asOf.atZone(KST)).minusMonths(1))) {
+      response.put("status", "INSUFFICIENT_HISTORY");
+      response.put("reason", "기준일에 가까운 연속 월별 가격 기록이 부족합니다. 현재 공개가격 또는 과거 추이를 확인해 주세요.");
+      return response;
+    }
+    double[] prices =
+        trailing.stream()
+            .mapToDouble(point -> Double.parseDouble(point.get("effectiveUsdGpuHour").toString()))
+            .toArray();
+    var projected = simulate(prices, HORIZON, PATHS, SEED);
+    var months = new ArrayList<Map<String, Object>>();
+    for (int i = 0; i < HORIZON; i++) {
+      months.add(
+          Map.of(
+              "month",
+              monthly.lastKey().plusMonths(i + 1).toString(),
+              "p10",
+              decimal(projected[i][0]),
+              "p50",
+              decimal(projected[i][1]),
+              "p90",
+              decimal(projected[i][2])));
+    }
+    response.put("status", "OK");
+    response.put("monthly", months);
+    response.put("horizonMonths", HORIZON);
+    response.put("paths", PATHS);
+    response.put("seed", SEED);
+    response.put("modelVersion", "monthly-log-return-bootstrap-v1");
+    response.put(
+        "assumptions",
+        List.of(
+            "동일 오퍼의 매월 마지막 적격 단가를 사용합니다.",
+            "과거 월별 가격 변화가 반복될 수 있다고 가정합니다.",
+            "분위수 범위는 모형이 생성한 시나리오 분포입니다."));
+    response.put("backtest", backtest(prices));
+    return response;
+  }
+
+  static double[][] simulate(double[] prices, int horizon, int paths, long seed) {
+    double[] changes = new double[prices.length - 1];
+    for (int i = 0; i < changes.length; i++) changes[i] = Math.log(prices[i + 1] / prices[i]);
+    double[][] population = new double[horizon][paths];
+    var random = new Random(seed);
+    for (int path = 0; path < paths; path++) {
+      double logPrice = Math.log(prices[prices.length - 1]);
+      for (int month = 0; month < horizon; month++) {
+        logPrice += changes[random.nextInt(changes.length)];
+        population[month][path] = Math.exp(logPrice);
+      }
+    }
+    double[][] result = new double[horizon][3];
+    for (int i = 0; i < horizon; i++) {
+      Arrays.sort(population[i]);
+      for (int q = 0; q < 3; q++) {
+        double fraction = (q * 4 + 1) / 10.0;
+        result[i][q] = population[i][(int) Math.round(fraction * (paths - 1))];
+      }
+    }
+    return result;
+  }
+
+  private static Map<String, Object> backtest(double[] prices) {
+    var comparisons = new ArrayList<Map<String, Object>>();
+    for (int horizon : List.of(1, 3, 12)) {
+      double error = 0, baseline = 0;
+      int covered = 0, count = 0;
+      for (int end = MIN_MONTHS; end + horizon - 1 < prices.length; end++) {
+        double actual = prices[end + horizon - 1];
+        double[] forecast = simulate(Arrays.copyOf(prices, end), horizon, 500, SEED)[horizon - 1];
+        error += Math.abs(actual - forecast[1]);
+        baseline += Math.abs(actual - prices[end - 1]);
+        if (actual >= forecast[0] && actual <= forecast[2]) covered++;
+        count++;
+      }
+      if (count > 0)
+        comparisons.add(
+            Map.of(
+                "horizonMonths",
+                horizon,
+                "count",
+                count,
+                "mae",
+                decimal(error / count),
+                "baselineMae",
+                decimal(baseline / count),
+                "intervalCoverage",
+                decimal((double) covered / count)));
+    }
+    return Map.of(
+        "status",
+        comparisons.isEmpty() ? "INSUFFICIENT_HISTORY" : "EVALUATED",
+        "horizons",
+        comparisons);
+  }
+
+  private static String decimal(double value) {
+    return BigDecimal.valueOf(value)
+        .setScale(6, RoundingMode.HALF_UP)
+        .stripTrailingZeros()
+        .toPlainString();
+  }
+
+  @SuppressWarnings("unchecked")
+  public static List<Map<String, Object>> records(Object value) {
+    return value == null ? List.of() : (List<Map<String, Object>>) value;
+  }
+
+  public static Instant instant(Object value) {
+    if (value instanceof Instant timestamp) return timestamp;
+    if (value instanceof OffsetDateTime timestamp) return timestamp.toInstant();
+    if (value instanceof Timestamp timestamp) return timestamp.toInstant();
+    return Instant.parse(value.toString());
+  }
+}
diff --git a/src/main/java/com/gpumarket/domain/market/service/MarketHistoryService.java b/src/main/java/com/gpumarket/domain/market/service/MarketHistoryService.java
