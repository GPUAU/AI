 class MarketOfferSummaryTest {
+  @Test
+  void includesEveryLowestProviderAndUsesTheSuccessfulCheckForTheFreshnessBoundary() {
+    var repository = mock(MarketOfferRepository.class);
+    var service = new MarketOfferService(repository, mock(ExchangeService.class));
+    when(repository.offers(anyMap()))
+        .thenAnswer(
+            call -> {
+              Map<String, Object> filters = call.getArgument(0);
+              var asOf = ((OffsetDateTime) filters.get("asOf")).toInstant();
+              var boundary = asOf.minus(48, ChronoUnit.HOURS);
+              var offers = new ArrayList<Map<String, Object>>();
+              for (long id = 1; id <= 8; id++) {
+                String price =
+                    switch ((int) id) {
+                      case 1 -> "3.20";
+                      case 6 -> "3.200000";
+                      case 7, 8 -> "0.50";
+                      default -> "5.00";
+                    };
+                var row = row(id, "east", 32, "firm", boundary, price);
+                row.put("offer_id", id);
+                row.put("observation_id", id);
+                row.put("observation_check_id", id);
+                row.put("provider_name", "Provider " + id);
+                row.put("collected_at", boundary.minusSeconds(60));
+                if (id == 6) {
+                  row.put("processing_status", "collection_failed");
+                  row.put("checked_at", asOf);
+                }
+                if (id == 8) {
+                  row.put("confirmed_at", boundary.minusNanos(1));
+                }
+                offers.add(row);
+              }
+              return offers;
+            });
+    when(repository.comparablePriceEvidence(anyList(), any()))
+        .thenAnswer(
+            call -> {
+              List<Long> checkIds = call.getArgument(0);
+              return checkIds.stream()
+                  .filter(id -> id != 7L)
+                  .map(MarketOfferSummaryTest::source)
+                  .toList();
+            });
+
+    var summary = service.summary(Map.of("modelId", "1"));
+    var group = (Map<?, ?>) ((List<?>) summary.get("groups")).get(0);
+    assertThat(group.get("minimum")).isEqualTo("3.20");
+    assertThat(group.get("sampleCounts"))
+        .isEqualTo(
+            Map.of("providerCount", 6, "productCount", 6, "offerCount", 6, "observationCount", 6));
+    assertThat(group.get("lowestProviderIds")).isEqualTo(List.of("1", "6"));
+    assertThat((List<?>) group.get("representatives")).hasSize(6);
+    var representative = (Map<?, ?>) ((List<?>) group.get("representatives")).get(5);
+    var asOf = (Instant) summary.get("asOf");
+    assertThat(representative.get("collectedAt"))
+        .isEqualTo(asOf.minus(48, ChronoUnit.HOURS).minusSeconds(60));
+    assertThat(representative.get("confirmedAt")).isEqualTo(asOf.minus(48, ChronoUnit.HOURS));
+    var evidence = (Map<?, ?>) ((List<?>) representative.get("sources")).get(0);
+    assertThat(evidence.get("sourceUrl")).isEqualTo("https://example.org/pricing/6");
+    var excluded = (Map<?, ?>) summary.get("excludedSummary");
+    assertThat(excluded.get("staleOffers")).isEqualTo(1);
+    assertThat(excluded.get("missingEvidenceOffers")).isEqualTo(1);
+  }
