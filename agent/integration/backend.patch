+        extrema.add(rangeEndpoint("MINIMUM", min, rows, sources));
+      } else {
+        var max = java.util.Collections.max(amounts);
+        boolean equal = min.compareTo(max) == 0;
+        extrema.add(rangeEndpoint(equal ? "BOTH" : "MINIMUM", min, rows, sources));
+        if (!equal) extrema.add(rangeEndpoint("MAXIMUM", max, rows, sources));
+      }
+    }
+    return map(
+        "items",
+        extrema,
+        "offerCount",
+        rows.size(),
+        "productCount",
+        rows.stream().map(row -> id(row, "product_id")).distinct().count(),
