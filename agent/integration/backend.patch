+    var params = query(filters(input, false), asOf);
+    params.put("publicPriceOnly", true);
+    var removed =
+        repository.offers(params).stream()
+            .filter(
+                row -> {
+                  Instant observed = time(row, "confirmed_at");
+                  Instant change = time(row, "disclosure_checked_at");
+                  return observed != null
+                      && change != null
+                      && change.isAfter(observed)
+                      && !change.isBefore(from)
+                      && change.isBefore(until)
+                      && ("not_found".equals(row.get("disclosure_processing_status"))
