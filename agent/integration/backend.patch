+  private static Instant priceSnapshot(Instant before) {
+    Instant now = Instant.now();
+    if (before == null) return now;
+    Instant boundary = before.minus(1, ChronoUnit.MICROS);
+    return boundary.isAfter(now) ? now : boundary;
+  }
+
+  private static List<Map<String, Object>> productPriceItems(
+      List<Map<String, Object>> rows, Map<Long, List<Map<String, Object>>> sources) {
+    var byProduct = new LinkedHashMap<Long, List<Map<String, Object>>>();
+    for (var row : rows) {
+      byProduct.computeIfAbsent(id(row, "product_id"), ignored -> new ArrayList<>()).add(row);
+    }
+    return byProduct.values().stream()
+        .map(productRows -> productPrices(productRows, sources))
+        .sorted(
+            Comparator.comparing(
+                    (Map<String, Object> item) -> stringOrEmpty(item.get("providerName")))
+                .thenComparing(item -> stringOrEmpty(item.get("regionCode")))
+                .thenComparing(item -> stringOrEmpty(item.get("sku"))))
+        .toList();
+  }
+
+  private static Map<String, Object> productPrices(
+      List<Map<String, Object>> rows, Map<Long, List<Map<String, Object>>> sources) {
+    var product = rows.get(0);
+    var onDemand =
+        rows.stream().filter(row -> "on_demand".equals(row.get("contract_type"))).toList();
+    var baselines = onDemand.stream().filter(row -> effectiveAmount(row).signum() > 0).toList();
+    var baseline = baselines.size() == 1 ? baselines.get(0) : null;
+    var commitments =
+        rows.stream()
+            .filter(row -> "commitment".equals(row.get("contract_type")))
+            .map(
+                row -> {
+                  var quote = productQuote(row, sources);
+                  String reason = contractDiscountReason(baselines.size(), baseline, row, null);
+                  quote.put("discountReason", reason);
+                  quote.put(
+                      "discountPercent",
+                      reason == null
+                          ? discountRate(baseline, row)
+                              .movePointRight(2)
+                              .stripTrailingZeros()
+                              .toPlainString()
+                          : null);
+                  quote.put(
+                      "baseOfferId", baseline == null ? null : string(baseline.get("offer_id")));
+                  return quote;
+                })
+            .toList();
+    return map(
+        "productId", string(product.get("product_id")),
+        "providerName", product.get("provider_name"),
+        "productName", product.get("original_product_name"),
+        "sku", product.get("sku"),
+        "regionCode", product.get("region_code"),
+        "countryCode", upper(product.get("country_code")),
+        "gpuCount", product.get("gpu_count"),
+        "systemType", upper(product.get("system_type")),
+        "serviceOption", upper(product.get("service_option")),
+        "onDemand", onDemand.stream().map(row -> productQuote(row, sources)).toList(),
+        "commitments", commitments);
+  }
+
+  private static Map<String, Object> productQuote(
+      Map<String, Object> row, Map<Long, List<Map<String, Object>>> sources) {
+    return map(
+        "offerId", string(row.get("offer_id")),
+        "contractProductType", upper(row.get("contract_product_type")),
+        "months", row.get("commitment_months"),
+        "paymentOption", payment(row),
+        "minimumQuantity", row.get("minimum_quantity"),
+        "minimumQuantityUnit", row.get("minimum_quantity_unit"),
+        "priceUsdGpuHour", decimal(effectiveAmount(row)),
+        "collectedAt", time(row, "collected_at"),
+        "sources", sources.get(id(row, "observation_check_id")));
+  }
+
+  private static BigDecimal discountRate(
+      Map<String, Object> baseline, Map<String, Object> commitment) {
+    var baseAmount = effectiveAmount(baseline);
+    return baseAmount
+        .subtract(effectiveAmount(commitment))
+        .divide(baseAmount, 6, RoundingMode.HALF_UP);
+  }
