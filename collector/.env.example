# collector 환경 변수 예시. 복사해서 .env로 쓰고, .env는 커밋하지 않는다.
# 배포 시에는 Kubernetes Secret 등에서 주입한다(이미지에 .env를 넣지 않음).

# 형식: postgresql://계정:비밀번호@주소:포트/DB이름
# 아래 두 값은 같은 DB 서버(로컬은 루트 docker-compose 컨테이너)를 가리키고, 끝의 DB 이름만 다르다.

# 실제 수집 데이터를 적재하는 DB. collect·backfill 명령이 쓴다(수집기 쓰기 계정)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/gpu_erd

# 테스트(pytest)가 접속하는 관리용 DB. 테스트는 여기서 임시 DB를 만들어 시험하고 끝나면 지운다.
# 실제 데이터 DB(gpu_erd)를 건드리지 않도록 서로 다른 DB로 둔다
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/postgres

# AWS 가격 API (IAM 사용자 gpu-price-collector, 가격 조회 권한만). EKS에서는 Kubernetes Secret으로 같은 이름의 환경 변수를 주입한다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 원천 파일 캐시 위치(선택). 기본 ./var/cache
# CACHE_DIR=var/cache
